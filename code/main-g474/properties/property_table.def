/* Single source of truth for the global property system.
 *
 * No header guard: this file is #included repeatedly, each time with a
 * different PROPERTY() definition, to generate the live-value struct, the
 * descriptor table and the compile-time tag check.
 *
 * PROPERTY(tag, type, name, <named metadata...>)
 *   tag             permanent blob identity used by the persistence layer.
 *                   NEVER reuse a tag, even after a property is removed.
 *                   0 (PROPERTY_TAG_NONE) marks a transient (non-persistent) property.
 *   type            C type of the value: uint16_t or bool
 *   name            struct member (direct read g_properties->name) and, stringized,
 *                   the lookup name
 *   .default_value  initial value and the value property_reset() restores
 *                   (bool: 0/1). Named .default would clash with the C keyword.
 *   .min .max       inclusive bounds; set() clamps, flash load defaults on
 *                   violation. Omit for bool (range is implicitly 0..1).
 *   .description    human-readable text for the editor
 *
 * Reserved (removed) tags: (none yet)
 */

PROPERTY(1, uint16_t, key_press,
         .default_value = 1900, .min = 0, .max = 4095,
         .description = "ADC below this -> key pressed")
PROPERTY(2, uint16_t, key_release,
         .default_value = 2100, .min = 0, .max = 4095,
         .description = "ADC above this -> key released")
PROPERTY(3, uint16_t, bellow_center,
         .default_value = 3775, .min = 0, .max = 8191,
         .description = "Combined hall reading at rest")
PROPERTY(4, uint16_t, bellow_dead,
         .default_value = 40, .min = 0, .max = 4095,
         .description = "Neutral half-width around center")
PROPERTY(5, uint16_t, bellow_hyst,
         .default_value = 20, .min = 0, .max = 4095,
         .description = "Margin given back before returning to neutral")
PROPERTY(6, uint16_t, bellow_full_push,
         .default_value = 3400, .min = 0, .max = 8191,
         .description = "Combined hall reading at full push")
PROPERTY(7, uint16_t, bellow_full_pull,
         .default_value = 4200, .min = 0, .max = 8191,
         .description = "Combined hall reading at full pull")
PROPERTY(8, uint16_t, bellow_cchyst,
         .default_value = 16, .min = 0, .max = 1024,
         .description = "Min expression-CC delta before resending")
PROPERTY(9, uint16_t, bellow_cc_period_ms,
         .default_value = 10, .min = 1, .max = 1000,
         .description = "Min milliseconds between expression-CC sends")
PROPERTY(10, uint16_t, bellow_settle_us,
         .default_value = 2, .min = 0, .max = 1000,
         .description = "Hall supply settling delay before sampling, microseconds")
PROPERTY(PROPERTY_TAG_NONE, bool, log_bellow,
         .default_value = 0,
         .description = "Log hall readings and bellows direction each poll")
PROPERTY(PROPERTY_TAG_NONE, bool, log_spi_stat,
         .default_value = 0,
         .description = "Log SPI link error and reception-rate statistics")
PROPERTY(PROPERTY_TAG_NONE, uint16_t, report_hz,
         .default_value = 4, .min = 1, .max = 30,
         .description = "Live-report dashboard refresh rate in Hz")
PROPERTY(PROPERTY_TAG_NONE, bool, show_bellow,
         .default_value = 0,
         .description = "Live-report the bellows direction, intensity and hall readings")
PROPERTY(PROPERTY_TAG_NONE, bool, show_spi,
         .default_value = 0,
         .description = "Live-report the per-wing SPI link reception counters and rates")
